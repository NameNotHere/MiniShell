NAME = pipex
CC = cc
CFLAGS = -Wall -Werror -Wextra -fno-common
LDFLAGS = -lreadline
RM = rm -f
INCLUDEDIR = include
INCLUDE = -I $(INCLUDEDIR)
SRCDIR = src/exec/
OBJDIR = src/exec/obj
SRCS = ft_mem_utils.c \
		ft_str_utils.c \
		pipex.c \
		pipex_process.c \
		pipex_heredoc.c \
		pipex_initialize.c \
		pipex_interactive.c \
		utils_error.c \
		utils_exit.c \
		utils_free.c \
		utils_mem.c \
		utils_path.c \
		utils_split_quotes.c \
		utils_split_single_delimiter.c \
		utils_string.c

OBJS = $(SRCS:.c=.o)
OBJS := $(addprefix $(OBJDIR)/, $(OBJS))

all: $(NAME)

$(NAME): $(OBJS)
	$(CC) $(CFLAGS) $(INCLUDE) -o $(NAME) $(OBJS) $(LDFLAGS)

$(OBJDIR)/%.o: $(SRCDIR)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(INCLUDE) -c -o $@ $<

clean:
	$(RM) $(OBJS)

fclean: clean
	$(RM) $(NAME)

re: fclean all

bonus: all

.PHONY: all clean fclean re bonus
