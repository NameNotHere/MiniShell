NAME = pipex
CC = cc
CFLAGS = -Wall -Werror -Wextra -fno-common
LDFLAGS = -lreadline
RM = rm -f
INCLUDEDIR = include
INCLUDE = -I $(INCLUDEDIR)
SRCDIR = src/
OBJDIR = src/obj
SRCS = pipex/ft_mem_utils.c \
		pipex/ft_str_utils.c \
		pipex/pipex.c \
		pipex/pipex_main.c \
		pipex/pipex_process.c \
		pipex/pipex_heredoc.c \
		pipex/pipex_initialize.c \
		pipex/pipex_interactive.c \
		pipex/utils_error.c \
		pipex/utils_exit.c \
		pipex/utils_free.c \
		pipex/utils_mem.c \
		pipex/utils_path.c \
		pipex/utils_split_quotes.c \
		pipex/utils_split_single_delimiter.c \
		pipex/utils_string.c

OBJS = $(SRCS:.c=.o)
OBJS := $(addprefix $(OBJDIR)/, $(OBJS))

all: $(NAME)

$(NAME): $(OBJS)
	$(CC) $(CFLAGS) $(INCLUDE) -o $(NAME) $(OBJS) $(LDFLAGS)

$(OBJDIR)/%.o: $(SRCDIR)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(INCLUDE) -c -o $@ $<

clean:
	$(RM) $(OBJS)

fclean: clean
	$(RM) $(NAME)

re: fclean all

bonus: all

.PHONY: all clean fclean re bonus
